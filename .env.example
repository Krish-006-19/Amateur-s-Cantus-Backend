# Backend environment variables (example)
# Copy to .env locally. On Render, set these in the service Environment tab.

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# Admin
ADMIN_KEY=

# Upload limits
SONG_UPLOADS_PER_DAY=2

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=

# Redis (use non-TLS for your current endpoint; switch to rediss:// only if your provider uses TLS)
REDIS_URL=redis://default:<PASSWORD>@redis-host:6379

# Server
PORT=3000
